# ==========================================================
# AR Trust Travel & Tourism — Environment Variables (example)
# Copy this file to ".env" and adjust values for local runs.
# On Hostinger, set these in the panel's "Environment Variables"
# section instead — the server reads them from process.env.
# ==========================================================

# Port the Node server listens on.
# Hostinger injects PORT automatically; locally it defaults to 3000.
PORT=3000

# Network interface to bind. Keep 0.0.0.0 so the host can reach it.
HOST=0.0.0.0

# Node environment.
NODE_ENV=production
