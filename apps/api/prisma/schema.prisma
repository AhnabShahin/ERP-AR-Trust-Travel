// =====================================================================
// AR Trust Travel & Tourism ERP — Prisma schema (MySQL)
// Generated from the app's domain types. Complex nested structures are
// stored as JSON columns; union-string fields are kept as String with a
// comment listing the allowed values so the API layer can validate them.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum UserRole {
  super_admin        @map("super-admin")
  admin
  operations_manager @map("operations-manager")
  transit_agent      @map("transit-agent")
  driver_guide       @map("driver-guide")
  finance_accountant @map("finance-accountant")
  vendor_partner     @map("vendor-partner")
  staff
  customer
}

enum AccountStatus {
  active
  inactive
}

// ---------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------

model User {
  id           String        @id @default(cuid())
  name         String
  nameAr       String?
  username     String        @unique
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole      @default(customer)
  phone        String?
  avatar       String?       @db.Text
  department   String?
  vendorId     String?
  // New accounts are created inactive and must be activated by an admin /
  // super-admin before the user can sign in.
  status       AccountStatus @default(inactive)
  lastLogin    DateTime?

  // Verification & profile
  isEmailVerified   Boolean   @default(false)
  emailVerifiedAt   DateTime?
  address           String?
  city              String?
  country           String?
  nationality       String?
  passportNumber    String?
  passportExpiry    String?
  preferredLanguage String?
  dietaryNotes      String?   @db.Text
  emergencyContact  String?
  emergencyPhone    String?
  licenseNumber     String?
  licenseCategory   String?
  experienceYears   Int?
  spokenLanguages   Json?
  companyName       String? // also used as the third-party driver's company
  // Driver sourcing (role = driver-guide): in-house vs. external/contracted.
  driverType        String? // first-party | third-party
  bio               String?   @db.Text

  // Staff-profile fields — only meaningful when role = staff. They let a staff
  // member's desk assignment, salary and target live on the user record, so the
  // "Staff" screen reads directly from the users table.
  jobTitle                String?
  assignedAirport         String?
  assignedDeskId          String?
  assignedDeskName        String?
  staffStatus             String? // On Duty | Available | On Leave | Off Duty
  hireDate                String?
  baseSalaryMonthlyQAR    Float   @default(0)
  monthlyServiceTarget    Int     @default(0)
  commissionPerServiceQAR Float   @default(0)
  rating                  Float   @default(0)
  totalExpensesQAR        Float   @default(0)

  // Per-month salary / commission ledger for this staff member.
  ledgerEntries StaffLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("users")
}

// One row per staff member per month — the salary & commission ledger that was
// previously an embedded JSON array on the Employee model.
model StaffLedgerEntry {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                    String   @db.VarChar(40) // e.g. 'October 2026'
  baseSalaryQAR            Float    @default(0)
  targetServices           Int      @default(0)
  completedServices        Int      @default(0)
  excessServices           Int      @default(0)
  commissionRatePerService Float    @default(0)
  commissionEarnedQAR      Float    @default(0)
  expensesReimbursedQAR    Float    @default(0)
  deductionsQAR            Float    @default(0)
  grossPayableQAR          Float    @default(0)
  amountPaidQAR            Float    @default(0)
  amountDueQAR             Float    @default(0)
  status                   String   @default("Pending Payout") // Fully Paid | Partially Paid | Pending Payout | Approved
  paidDate                 String?
  notes                    String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@unique([userId, month])
  @@index([userId])
  @@map("staff_ledger_entries")
}

// ---------------------------------------------------------------------
// Bookings (airport transfer / tours)
// ---------------------------------------------------------------------

model Booking {
  id              String   @id @default(cuid())
  pnr             String   @unique
  passengerName   String
  passengerPhone  String
  passengerEmail  String
  nationality     String
  flightNumber    String
  arrivalAirport  String
  arrivalTime     String
  terminalGate    String?
  pickupBay       String?
  packageId       String
  packageName     String
  packageNameAr   String?
  paxCount        Int      @default(1)
  totalQAR        Float    @default(0)
  paymentCurrency String   @default("QAR") // QAR | USD | EUR | GBP
  paymentMethod   String // Cash | POS Card | Payment Link | Prepaid OTA | Website Online Gateway
  driverId        String?
  driverName      String?
  driverVehicle   String?
  driverPhone     String?
  guideId         String?
  guideName       String?
  qrStatus        String   @default("pending") // BookingStatus union
  qrCodeUrl       String?  @db.Text
  voucherSent     Boolean  @default(false)
  bookingDate     String?
  bookingTime     String?
  notes           String?  @db.Text
  deskId          String?
  deskCode        String?
  source          String   @default("Airport Desk")
  leadType        String? // tour | package | fleet | service
  // ---- Service / trip layer (unified booking = consumed service record) ----
  serviceType     String    @default("tour-service") // tour-service | tour-package | transfer
  customerId      String? // link to a Guest (CRM)
  vehicleId       String? // fleet vehicle assigned FOR THIS TRIP
  vehicleName     String?
  vehiclePlate    String?
  tripStatus      String    @default("Scheduled") // Scheduled | On Trip | Completed | Cancelled | No Show
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  invoiceId       String? // set when an invoice is generated from this booking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@index([qrStatus])
  @@index([source])
  @@index([tripStatus])
  @@index([serviceType])
  @@map("bookings")
}

// Lifecycle timeline for a booking/trip — every status transition is logged so
// the ops & reporting views can show when each service was taken / completed.
model TripStatusLog {
  id          String   @id @default(cuid())
  bookingId   String
  serviceType String?
  fromStatus  String?
  toStatus    String
  driverId    String?
  vehicleId   String?
  actorId     String?
  actorName   String?
  note        String?  @db.Text
  at          DateTime @default(now())

  @@index([bookingId])
  @@map("trip_status_logs")
}

// ---------------------------------------------------------------------
// Fleet & field personnel
// ---------------------------------------------------------------------

model FleetVehicle {
  id                 String   @id @default(cuid())
  name               String
  nameAr             String?
  category           String
  passengers         Int
  luggage            Int
  priceQAR           Float
  rateType           String
  features           Json // string[]
  image              String   @db.Text
  idealFor           String
  assignedDriverId   String?
  assignedDriverName String?
  plateNumber        String?
  modelYear          String?
  // Vehicle registry detail (from the fleet sheet): make, model & colour.
  make               String?
  model              String?
  color              String?
  // Operational availability + sourcing (owned fleet vs. a third-party car).
  status             String   @default("Available") // Available | On Trip | Maintenance | Reserved
  ownership          String   @default("owned") // owned | third-party
  showOnWebsite      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("fleet_vehicles")
}

model Driver {
  id               String   @id @default(cuid())
  name             String
  nameAr           String?
  phone            String
  // Driver sourcing: in-house staff vs. an external/contracted driver.
  driverType       String   @default("first-party") // first-party | third-party
  company          String? // third-party company / vendor name
  // DEPRECATED free-text vehicle fields — a vehicle is assigned per-trip on the
  // Booking now, and these columns are dropped in Phase 2 once the UI is rewired.
  vehicle          String?
  plateNumber      String?
  vehicleType      String?
  status           String // Available | On Trip | Standby | Off Duty | Maintenance
  currentMission   String?
  activePassengers Int?
  totalTripsToday  Int      @default(0)
  location         String
  rating           Float    @default(0)
  image            String?  @db.Text
  fleetVehicleId   String? // optional default / home vehicle (not the trip assignment)
  priceQAR         Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("drivers")
}

model TourGuide {
  id                 String   @id @default(cuid())
  name               String
  nameAr             String?
  phone              String
  languages          Json // string[]
  specialty          String
  status             String // Assigned | Available | On Tour
  toursLedToday      Int      @default(0)
  totalCommissionQAR Float    @default(0)
  rating             Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("tour_guides")
}

// ---------------------------------------------------------------------
// HR / Payroll
// ---------------------------------------------------------------------

model Employee {
  id                      String   @id @default(cuid())
  name                    String
  nameAr                  String?
  email                   String
  phone                   String
  role                    String
  department              String
  assignedAirport         String?
  assignedDeskId          String?
  assignedDeskName        String?
  status                  String // On Duty | Available | On Leave | Off Duty
  hireDate                String
  baseSalaryMonthlyQAR    Float    @default(0)
  monthlyServiceTarget    Int      @default(0)
  commissionPerServiceQAR Float    @default(0)
  monthlyRecords          Json? // EmployeeMonthlyRecord[]
  totalExpensesQAR        Float    @default(0)
  rating                  Float    @default(0)
  emergencyContact        String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("employees")
}

// ---------------------------------------------------------------------
// Guests / CRM
// ---------------------------------------------------------------------

model GuestTier {
  id                 String  @id @default(cuid())
  name               String
  nameAr             String?
  discountPercentage Float   @default(0)
  badgeColor         String?
  minSpendQAR        Float?
  description        String? @db.Text

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("guest_tiers")
}

model Guest {
  id                 String   @id @default(cuid())
  name               String
  nationality        String
  phone              String
  email              String
  vipTier            String
  passportNo         String?
  totalBookings      Int      @default(0)
  totalSpentQAR      Float    @default(0)
  lastArrivalAirport String?
  lastFlight         String?
  lastTripDate       String?
  specialPreferences String?  @db.Text
  bookingIds         Json? // string[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("guests")
}

// ---------------------------------------------------------------------
// Hotel partners
// ---------------------------------------------------------------------

model HotelVendor {
  id              String   @id @default(cuid())
  name            String
  nameAr          String?
  locationZone    String
  starRating      Int
  contactPerson   String
  contactPhone    String
  contactEmail    String
  address         String   @db.Text
  commissionRate  Float    @default(0)
  desks           Json // HotelVendorDesk[]
  roomOptions     Json // HotelRoomOption[]
  contractStatus  String
  totalBookings   Int      @default(0)
  totalRevenueQAR Float    @default(0)
  imageUrl        String?  @db.Text
  amenities       Json // string[]
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("hotel_vendors")
}

model HotelBooking {
  id                  String   @id @default(cuid())
  confirmationCode    String   @unique
  hotelId             String
  hotelName           String
  hotelLocation       String?
  guestName           String
  guestPhone          String
  guestEmail          String
  guestNationality    String?
  roomType            String
  roomsCount          Int      @default(1)
  paxAdults           Int      @default(1)
  paxChildren         Int      @default(0)
  checkInDate         String
  checkOutDate        String
  nights              Int
  mealPlan            String
  ratePerNightQAR     Float
  totalQAR            Float
  commissionRate      Float    @default(0)
  commissionEarnedQAR Float    @default(0)
  bookingSource       String
  deskCode            String?
  agentName           String?
  paymentMethod       String
  paymentStatus       String
  bookingStatus       String
  specialRequests     String?  @db.Text
  voucherSent         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("hotel_bookings")
}

// ---------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------

model FinanceExpense {
  id              String   @id @default(cuid())
  date            String
  category        String
  description     String   @db.Text
  amountQAR       Float
  approvedBy      String?
  status          String // Pending Review | Approved | Paid | Rejected
  paymentMethod   String?
  department      String?
  requestedBy     String?
  requestedByRole String?
  submittedBy     String?
  receiptRef      String?
  receiptNumber   String?
  merchant        String?
  deskId          String?
  deskName        String?
  approvedAt      String?
  approvalNotes   String?  @db.Text
  notes           String?  @db.Text
  rejectedReason  String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@index([status])
  @@map("finance_expenses")
}

model CurrencyItem {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  symbol           String
  rateToQAR        Float
  isPegged         Boolean  @default(false)
  peggedNote       String?
  bankAccount      String?
  cashVaultBalance Float    @default(0)
  updatedAt        DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("currency_items")
}

model CurrencyHistory {
  id                   String   @id @default(cuid())
  date                 String
  time                 String?
  currencyCode         String
  currencyName         String
  rateToQAR            Float
  previousRateToQAR    Float?
  vaultBalance         Float
  balanceQAREquivalent Float
  recordedBy           String
  changeType           String
  notes                String?  @db.Text
  createdAt            DateTime @default(now())

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@index([currencyCode])
  @@map("currency_history")
}

// ---------------------------------------------------------------------
// Services / packages (website + dashboard sync)
// ---------------------------------------------------------------------

model TourPackage {
  id               String   @id @default(cuid())
  name             String
  nameAr           String?
  serviceType      String?
  category         String
  duration         String
  priceQAR         Float
  description      String   @db.Text
  descriptionAr    String?  @db.Text
  pickupLocation   String?
  includes         Json // string[]
  image            String?  @db.Text
  badge            String?
  groupSize        String?
  departure        String?
  rating           Float?
  reviewCount      Int?
  originalPriceQAR Float?
  isMultiDay       Boolean  @default(false)
  days             Int?
  nights           Int?
  highlights       Json? // string[]
  excluded         Json? // string[]
  isFeatured       Boolean  @default(false)
  showOnWebsite    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("tour_packages")
}

model ServiceCategory {
  id          String  @id @default(cuid())
  name        String
  nameAr      String?
  serviceType String // Tour Service | Tour Package | Transfer Service

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("service_categories")
}

// ---------------------------------------------------------------------
// Airport desks & shifts
// ---------------------------------------------------------------------

// A physical location where an agent desk can be stationed: an airport or a
// resort/hotel. This is the single source for the desk "location" dropdown and
// is managed via its own CRUD (/api/locations). Agent desks reference it by
// `locationId`; the desk also keeps denormalized display fields (airportCode /
// airportName / hotelName) populated from the chosen location.
model Location {
  id            String        @id @default(cuid())
  name          String
  nameAr        String?
  type          String // 'airport' | 'resort'
  code          String        @unique // HIA, DIA, RC, FR, …
  city          String?
  address       String?
  hotelVendorId String? // optional link for resort locations
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  desks         AirportDesk[]

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("locations")
}

model AirportDesk {
  id                   String    @id @default(cuid())
  locationId           String?
  location             Location? @relation(fields: [locationId], references: [id])
  airportCode          String
  airportName          String
  deskCode             String    @unique
  deskName             String
  deskNameAr           String?
  terminal             String
  zone                 String?
  assignedEmployeeId   String?
  assignedEmployeeName String?
  assignedEmployeeRole String?
  status               String
  shiftTiming          String?
  phoneExt             String?
  notes                String?   @db.Text
  operatingHours       String?
  dailyTargetQAR       Float?
  currentDrawerCashQAR Float?
  deskType             String?
  hotelVendorId        String?
  hotelName            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("airport_desks")
}

model DeskAssignment {
  id           String   @id @default(cuid())
  deskId       String
  deskCode     String
  deskName     String
  airportCode  String
  terminal     String
  employeeId   String
  employeeName String
  employeeRole String
  assignedDate String
  shiftTiming  String
  assignedBy   String
  status       String
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("desk_assignments")
}

// ---------------------------------------------------------------------
// Notifications & audit
// ---------------------------------------------------------------------

model Notification {
  id          String   @id @default(cuid())
  title       String
  titleAr     String?
  message     String   @db.Text
  messageAr   String?  @db.Text
  time        String?
  type        String // flight | driver | cash | vip | booking | hotel
  read        Boolean  @default(false)
  actionLabel String?
  createdAt   DateTime @default(now())

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("notifications")
}

model SystemAuditLog {
  id        String   @id @default(cuid())
  timestamp String?
  actor     String?
  role      String?
  action    String
  category  String? // FINANCE | SECURITY | DISPATCH | POS | SYSTEM
  details   String?  @db.Text
  status    String? // SUCCESS | WARNING | ALERT
  createdAt DateTime @default(now())

  @@index([category])
  @@map("system_audit_logs")
}

// ---------------------------------------------------------------------
// Payroll reference data
// ---------------------------------------------------------------------

model SalaryRecord {
  id                   String   @id @default(cuid())
  employeeName         String
  roleTitle            String
  department           String
  fixedBaseMonthlyQAR  Float    @default(0)
  accruedCommissionQAR Float    @default(0)
  netPayableQAR        Float    @default(0)
  paymentCycle         String
  payoutStatus         String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("salary_records")
}

model CommissionRule {
  id              String   @id @default(cuid())
  targetRole      String
  ruleDescription String   @db.Text
  type            String
  rateValue       Float
  unit            String
  appliesTo       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Audit: who created / last modified this row (user id + display name).
  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("commission_rules")
}

// ---------------------------------------------------------------------
// Generic key/value app settings (singletons & config: exchange rates,
// shift drawer, package categories, category→service map, etc.)
// ---------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------
// Uploaded & optimized images, stored as binary IN the database so the
// reference persisted on records (avatars, fleet/vehicle, hotel, package
// photos) never contains a host name — only "/api/uploads/<id>". That keeps
// image links stable when the production host changes.
// ---------------------------------------------------------------------

model Upload {
  id        String   @id @default(cuid())
  mime      String // e.g. image/webp
  path      String // disk filename under UPLOAD_DIR, host-less (e.g. "<id>.webp")
  width     Int?
  height    Int?
  size      Int // byte length of the stored (optimized) image
  createdAt DateTime @default(now())

  @@map("uploads")
}

// ---------------------------------------------------------------------
// Public website CMS — customer reviews + editable site content.
// ---------------------------------------------------------------------

model Review {
  id            String   @id @default(cuid())
  author        String
  country       String?
  rating        Int      @default(5)
  date          String? // human label e.g. "February 2026"
  tour          String? // which experience the review is about
  comment       String   @db.Text
  avatar        String?  @db.Text
  showOnWebsite Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("reviews")
}

// ---------------------------------------------------------------------
// Billing — payment accounts + invoices (BizBill-style).
// `items` and `payments` are JSON (line items / payment ledger) to match the
// codebase convention of storing nested structures as JSON columns. Links to
// a Booking are kept as plain string ids (no FK), like the rest of the schema.
// ---------------------------------------------------------------------

// A payment account / method (bank, cash, wallet…) used when recording an
// invoice payment. Its currentBalance is bumped as payments are recorded.
model PaymentAccount {
  id             String   @id @default(cuid())
  title          String // e.g. "Qatar Bank", "Cash", "bKash"
  openingDate    String // ISO date label (yyyy-mm-dd)
  accountNumber  String?
  currency       String   @default("QAR")
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  note           String?  @db.Text
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@map("payment_accounts")
}

model Invoice {
  id          String @id @default(cuid())
  invoiceNumber String @unique // e.g. "INV-260001"
  publicToken   String @unique // opaque token for the public /invoice/<token> page
  status        String @default("unpaid") // unpaid | partial | paid

  // Bill-To / customer
  customerId      String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerAddress String? @db.Text
  customerTRN     String?

  // Dates (stored as yyyy-mm-dd labels for parity with the rest of the app)
  invoiceDate String
  dueDate     String?

  // Money
  currency      String  @default("QAR")
  items         Json // [{ name, description?, qty, unit?, unitCost, vatPercent, vatAmount, amount }]
  subTotal      Float   @default(0)
  discount      Float   @default(0)
  vatTotal      Float   @default(0)
  grandTotal    Float   @default(0)
  amountPaid    Float   @default(0)
  balanceDue    Float   @default(0)
  amountInWords String? @db.Text

  // Payment ledger — [{ id, date, method, accountId?, accountTitle?, note?, amount }]
  payments Json?

  // Extras
  notes      String? @db.Text
  terms      String? @db.Text
  source     String  @default("Manual") // Manual | Booking
  bookingId  String? // optional link to a Booking row
  bookingPnr String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@index([status])
  @@index([bookingId])
  @@map("invoices")
}

// ---------------------------------------------------------------------
// Online booking platforms / channels — the OTA partners AR Trust receives
// business from, grouped by `type` (tour vs airport-transfer). Hotels have
// their own model (HotelVendor); this covers the other two groups.
// ---------------------------------------------------------------------
model Platform {
  id           String   @id @default(cuid())
  name         String
  type         String // 'tour' | 'airport-transfer'
  contactPhone String?
  website      String?
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy     String?
  createdByName String?
  updatedBy     String?
  updatedByName String?

  @@index([type])
  @@map("platforms")
}

// Key/value store for every editable piece of public-site text & content.
// `value` is JSON so a key can hold a string, a block of text, an image ref,
// or a structured list (e.g. the Why-Us points). `group`/`label`/`kind` drive
// the dashboard "Website Content" editor; public pages read by `key`.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String? // editor grouping, e.g. "home.hero" / "contact" / "footer"
  label     String? // human label shown in the editor
  kind      String   @default("text") // text | textarea | html | image | list | json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy     String?
  updatedByName String?

  @@map("site_content")
}
