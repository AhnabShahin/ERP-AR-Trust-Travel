# =====================================================================
# AR Trust API — environment variables (copy to .env for local runs)
# =====================================================================

# MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example (XAMPP/MySQL default):
DATABASE_URL="mysql://root:@localhost:3306/ar_trust_erp"

# Port the API server listens on.
PORT=4000

# Allowed browser origin (the Next.js web app).
CORS_ORIGIN="http://localhost:3000"

# Secret used to sign JWT access tokens. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

NODE_ENV=development
